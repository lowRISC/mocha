{
  name: "cva6_cheri",
  target_dir: "cva6_cheri",

  upstream: {
    url: "https://github.com/Capabilities-Limited/cheri-cva6.git",
    // Mocha integration branch rebased onto RVY 0.9.10 (d00909435).
    rev: "mocha-update-RVY",
  },

  exclude_from_upstream: [
    // Broken build files.
    "ariane.core",
    // CI configurations.
    ".github",
    ".gitlab-ci",
    // External dependencies.
    // CVFPU is imported separately by cvfpu.vendor.hjson.
    "core/cvfpu",
    "corev_apu",
    "vendor",
    "verif",
  ]
}
