{
  name: "tagctrl",
  target_dir: "tagctrl",
  patch_dir: "patches/tagctrl",

  upstream: {
    url: "https://github.com/Capabilities-Limited/axi_cheri_tagcontroller.git",
    rev: "main",
  },

  exclude_from_upstream: [
    // CI, editor and Nix configurations.
    ".github",
    ".vscode",
    "flake.lock",
    "flake.nix",
    // External dependencies.
    "src/common_cells",
  ]
}
