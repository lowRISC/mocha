{
  name: "pulp_riscv_dbg",
  target_dir: "pulp_riscv_dbg",
  patch_dir: "patches/pulp_riscv_dbg",

  upstream: {
    url: "https://github.com/Capabilities-Limited/riscv-dbg.git",
    // CHERI-aware debug ROM and abstract commands used by CVA6-CHERI.
    rev: "RVY-cva6",
  },

  exclude_from_upstream: [
    "src/dm_obi_top.sv",
    "src_files.yml",
    # We always exclude .clang-format from upstream repos
    "tb/.clang-format",
  ]
}
