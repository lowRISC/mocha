diff --git a/src/dm_top.sv b/src/dm_top.sv
index 799602f..2af28ba 100644
--- a/src/dm_top.sv
+++ b/src/dm_top.sv
@@ -94,6 +94,8 @@ module dm_top #(
   logic [dm::DataCount-1:0][31:0]   data_mem_csrs;
   logic                             data_valid;
   logic                             ndmreset;
+  logic                             ndmreset_pending;
+  logic                             ndmreset_ack;
   logic [19:0]                      hartsel;
   // System Bus Access Module
   logic [BusWidth-1:0]              sbaddress_csrs_sba;
@@ -131,7 +133,7 @@ module dm_top #(
     .dmi_resp_ready_i,
     .dmi_resp_o,
     .ndmreset_o              ( ndmreset              ),
-    .ndmreset_ack_i          ( ndmreset_ack_i        ),
+    .ndmreset_ack_i          ( ndmreset_ack          ),
     .dmactive_o,
     .hartsel_o               ( hartsel               ),
     .hartinfo_i,
@@ -236,4 +238,20 @@ module dm_top #(
     .rdata_o                 ( slave_rdata_o         )
   );
 
+  always_ff @(posedge clk_i or negedge rst_ni) begin : handle_reset_pending
+    if (!rst_ni) begin
+      ndmreset_pending <= 1'b0;
+    end else begin
+      if (ndmreset) begin
+        ndmreset_pending <= 1'b1;
+      end else if (ndmreset_ack) begin
+        ndmreset_pending <= 1'b0;
+      end
+    end
+  end
+
+  // Gate the acknowledgement input on whether a reset is pending and if there
+  // is not another non-debug module reset being requested immediately.
+  assign ndmreset_ack = ndmreset_pending & !ndmreset & ndmreset_ack_i;
+
 endmodule : dm_top
