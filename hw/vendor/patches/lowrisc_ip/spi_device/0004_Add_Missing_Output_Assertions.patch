+  `ASSERT_KNOWN(PassthroughSEnKnownO_A,   passthrough_o.s_en)
 
   // Assume the tpm_en is set when TPM transaction is idle.
   `ASSUME(TpmEnableWhenTpmCsbIdle_M, $rose(cfg_tpm_en) |-> cio_tpm_csb_i)
