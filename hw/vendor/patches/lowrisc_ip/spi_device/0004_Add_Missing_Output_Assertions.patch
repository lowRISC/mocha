diff --git a/rtl/spi_device.sv b/rtl/spi_device.sv
index ed91ace..063052e 100644
--- a/rtl/spi_device.sv
+++ b/rtl/spi_device.sv
@@ -1973,6 +1973,19 @@ module spi_device
   `ASSERT_KNOWN(AlertKnownO_A,         alert_tx_o)
 
