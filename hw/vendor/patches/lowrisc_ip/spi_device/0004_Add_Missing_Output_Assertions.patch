+  `ASSERT_KNOWN(PassthroughEnKnownO_A,    passthrough_o.passthrough_en)
+  `ASSERT_KNOWN(PassthroughSckKnownO_A,   passthrough_o.sck)
+  `ASSERT_KNOWN(PassthroughSckEnKnownO_A, passthrough_o.sck_en)
+  `ASSERT_KNOWN(PassthroughCsbKnownO_A,   passthrough_o.csb)
