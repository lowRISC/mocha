name: "cosmic::tagctrl"
description: "CHERI tag controller core file for COSMIC project."

filesets:
  files_rtl:
    depend:
      - cosmic::pulp_axi_llc
      - lowrisc:cosmic:hpdcache
      - pulp-platform.org::axi
      - lowrisc:prim:assert
      - lowrisc:prim:fifo
      - lowrisc:prim:util
      - lowrisc:common_cells:all
    files:
      # Includes.
      - tagctrl/include/axi_tagctrl/typedef.svh: {is_include_file: true, include_path: tagctrl/include}
      # Packages.
      - tagctrl/src/axi_tagctrl_pkg.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_hpdcache_configs.sv
      # Tag controller configuration.
      - tagctrl/src/axi_tagctrl_config.sv
      # Tag lookup engine.
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_root_init.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_hpdcache_wrapper.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_hpdcache_read_req_rsp_wrapper.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_hpdcache_write_req_rsp_wrapper.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_flushing.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_table_lookups.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_table_lookups_read.sv
      - tagctrl/src/tag_lookup_engine/tag_lookup_engine_table_lookups_write.sv
      # Tag controller.
      - tagctrl/src/axi_tagc_read_unit.sv
      - tagctrl/src/axi_tagc_write_unit.sv
      - tagctrl/src/axi_tagctrl_ax.sv
      - tagctrl/src/axi_tagctrl_r.sv
      - tagctrl/src/axi_tagctrl_w.sv
      - tagctrl/src/axi_tagctrl_top.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
