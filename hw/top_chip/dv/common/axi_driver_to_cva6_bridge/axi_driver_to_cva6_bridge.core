name: "lowrisc:mocha_dv:axi_driver_to_cva6_bridge:0.1"
description: "Stand-in for the CVA6 core that drives its crossbar host port from an active AXI VIP."
filesets:
  files_dv:
    depend:
      - lowrisc:mocha_dv:axi_vip
      - lowrisc:mocha:top_chip_system
    files:
      - axi_driver_to_cva6_bridge.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
