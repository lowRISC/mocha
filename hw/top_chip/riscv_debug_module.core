name: "lowrisc:mocha:riscv_debug_module"
description: "RISC-V debug module and JTAG DTM for Mocha"

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:blanker
      - lowrisc:mocha_constants:top_pkg
      - lowrisc:mocha_constants:jtag_id_pkg
      - pulp-platform.org::axi
      - pulp-platform.org::riscv_dbg
      - cosmic::cva6cheri
    files:
      - rtl/riscv_debug_module.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
