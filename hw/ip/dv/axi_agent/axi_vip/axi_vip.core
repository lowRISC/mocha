name: "lowrisc:mocha_dv:axi_vip"
description: "Bridge between a pulp_axi struct port and the axi_agent channel interfaces"

filesets:
  files_vip:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:common_ifs
      - lowrisc:mocha_dv:axi_agent:0.1
    files:
      - axi_vip_if.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_vip
