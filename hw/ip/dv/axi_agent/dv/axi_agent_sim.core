name: "lowrisc:mocha_dv:axi_agent_sim:0.1"
description: "AXI agent self-test sim target"

filesets:
  files_dv:
    depend:
      - lowrisc:mocha_dv:axi_agent_test:0.1
      - lowrisc:mocha_dv:axi_agent_sva:0.1
      - lowrisc:mocha_dv:axi_agent_pulp:0.1
      - lowrisc:mocha_dv:axi_vip
      - lowrisc:dv:common_ifs
      - pulp-platform.org::axi
    files:
      - tb/axi_agent_lite_glue.sv
      - tb/tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_dv
    # Use fusesoc's vcs file list for dvsim, including xcelium runs
    default_tool: vcs
