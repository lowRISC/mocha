name: "lowrisc:mocha_dv:axi_agent_env:0.1"
description: "AXI agent self-test UVM environment"

filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_lib
      - lowrisc:mocha_dv:axi_agent:0.1
      - pulp-platform.org::axi
    files:
      - axi_agent_probe_if.sv
      - ../tb/axi_agent_pulp_ctrl_if.sv
      - axi_agent_env_pkg.sv
      - axi_agent_mapped_mem.sv: {is_include_file: true}
      - axi_agent_link_cfg.sv: {is_include_file: true}
      - axi_agent_env_cfg.sv: {is_include_file: true}
      - axi_agent_mgr_txn.sv: {is_include_file: true}
      - axi_agent_bridge_burst.sv: {is_include_file: true}
      - axi_agent_rand_req.sv: {is_include_file: true}
      - axi_agent_reg_block.sv: {is_include_file: true}
      - axi_agent_reg_ok_filter.sv: {is_include_file: true}
      - axi_agent_virtual_sequencer.sv: {is_include_file: true}
      - axi_agent_scoreboard.sv: {is_include_file: true}
      - axi_agent_env.sv: {is_include_file: true}
      - seq_lib/axi_agent_vseq_list.sv: {is_include_file: true}
      - seq_lib/axi_agent_base_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_top_addr_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_out_of_order_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_backpressure_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_errors_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_reset_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_off_edge_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_preset_rsp_seq.sv: {is_include_file: true}
      - seq_lib/axi_agent_rsp_order_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_mapped_mem_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_lite_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_exclusive_vseq.sv: {is_include_file: true}
      - seq_lib/axi_agent_reg_layer_vseq.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
