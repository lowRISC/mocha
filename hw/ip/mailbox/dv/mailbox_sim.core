name: "lowrisc:mocha_dv:mailbox_sim:0.1"
description: "Mailbox block-level DV sim target"

filesets:
  files_rtl:
    depend:
      - pulp-platform.org::axi

  files_dv:
    depend:
      - lowrisc:mocha_dv:mailbox_test:0.1
      - lowrisc:mocha_dv:axi_vip
      - lowrisc:dv:common_ifs
    files:
      - tb/tb.sv
    file_type: systemVerilogSource

targets:
  sim:
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    # DVSim needs the VCS file list even when running Xcelium
    default_tool: vcs
