name: "lowrisc:mocha_dv:axi_sram_seq"
description: "axi_sram block-level virtual sequences"

filesets:
  files_seq:
    depend:
      - lowrisc:mocha_dv:axi_sram_env
    files:
      - axi_sram_seq_pkg.sv
      - axi_sram_vseq_list.svh: {is_include_file: true}
      - axi_sram_base_vseq.svh: {is_include_file: true}
      - axi_sram_rst_sanity_vseq.svh: {is_include_file: true}
      - axi_sram_write_read_vseq.svh: {is_include_file: true}
      - axi_sram_tag_write_vseq.svh: {is_include_file: true}
      - axi_sram_cap_ruser_vseq.svh: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_seq
